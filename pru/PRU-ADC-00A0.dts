/*
 * Device Tree Overlay for PRU ADC Sampling
 * Enables PRU and configures AIN1 (P9_40) for analog input
 */

/dts-v1/;
/plugin/;

/ {
    compatible = "ti,beaglebone", "ti,beaglebone-black";

    /* Identification */
    part-number = "PRU-ADC";
    version = "00A0";

    /* Pin configuration */
    fragment@0 {
        target = <&am33xx_pinmux>;
        __overlay__ {
            pru_adc_pins: pinmux_pru_adc_pins {
                pinctrl-single,pins = <
                    /* P9_40: AIN1 - Analog Input */
                    0x1B4 0x27  /* gpio0[20], MODE7 | INPUT | PULLDOWN */
                >;
            };
        };
    };

    /* Enable ADC */
    fragment@1 {
        target = <&tscadc>;
        __overlay__ {
            status = "okay";
            adc {
                ti,adc-channels = <0 1 2 3 4 5 6 7>;
                ti,chan-step-avg = <0x1 0x1 0x1 0x1 0x1 0x1 0x1 0x1>;
                ti,chan-step-opendelay = <0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
                ti,chan-step-sampledelay = <0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
            };
        };
    };

    /* Enable PRU */
    fragment@2 {
        target = <&pruss>;
        __overlay__ {
            status = "okay";
        };
    };

    /* PRU ICSS configuration */
    fragment@3 {
        target = <&ocp>;
        __overlay__ {
            pru_adc {
                compatible = "ti,pru-rproc";
                pinctrl-names = "default";
                pinctrl-0 = <&pru_adc_pins>;
                status = "okay";
            };
        };
    };
};
