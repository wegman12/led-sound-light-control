+	dev_info(mcasp->dev, "DEBUG: mcasp_set_clk_pdir PDIR=0x%08x ACLKXCTL(after)=0x%08x\n",
+		 mcasp_get_reg(mcasp, DAVINCI_MCASP_PDIR_REG),
+		 mcasp_get_reg(mcasp, DAVINCI_MCASP_ACLKXCTL_REG));
 }
 
