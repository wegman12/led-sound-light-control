# The app normally talks to its API on the SAME origin using relative URLs
# (Traefik routes /api and /health to the Go server). Leave VITE_API_BASE_URL
# unset for both production builds and normal `npm run dev`.
#
# In dev, `npm run dev` proxies /api and /health to the target below.
# VITE_DEV_API_TARGET=http://bbb1.wegman:8080

# Only set this to point the built app at a DIFFERENT origin than the one
# serving it. Doing so reintroduces cross-origin requests.
# VITE_API_BASE_URL=http://localhost:8080
