[Unit]
Description=GPIO IR Receiver Pin Configuration
Documentation=https://github.com/kevinwegman/led-sound-light-control
DefaultDependencies=no
Before=sysinit.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/setup-gpio-ir.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
