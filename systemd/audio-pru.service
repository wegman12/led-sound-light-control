[Unit]
Description=Enable PRU1 Audio Sampling Firmware
Documentation=https://github.com/kevinwegman/led-sound-light-control
Before=led-sound-light-control.service
After=sysinit.target local-fs.target

[Service]
Type=oneshot
# Wait for remoteproc to be available, then start the PRU
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5 6; do \
  sleep 60; \
  if [ -f /sys/class/remoteproc/remoteproc2/state ]; then \
    echo "start" > /sys/class/remoteproc/remoteproc2/state && exit 0; \
  fi; \
  echo "Waiting for remoteproc2 (attempt $i/5)..."; \
done; \
echo "ERROR: remoteproc2 not available after 360 seconds"; \
exit 1'
ExecStop=/bin/sh -c 'echo "stop" > /sys/class/remoteproc/remoteproc2/state'
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
